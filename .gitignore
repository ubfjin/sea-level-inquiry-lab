# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
backend/data/
backend/.pytest_cache/
backend/**/__pycache__/
**/__pycache__/
*.py[cod]

# Scientific source and generated grids stay on the data server, not GitHub/Vercel.
/data/source/
/data/processed/**/*.nc
/data/processed/**/*.mat

/.pnpm-store/
/.pytest_cache/
*.tsbuildinfo
